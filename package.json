{
  "name": "dsh-session-context-config",
  "version": "0.4.0",
  "license": "MIT",
  "author": "Jia",
  "description": "Context profiles for new sessions: choose the tools and the system prompt each new conversation receives.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majia007/dsh-session-context-config.git"
  },
  "bugs": {
    "url": "https://github.com/majia007/dsh-session-context-config/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "baseline.js",
    "host/",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
