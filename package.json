{
  "name": "@jia-tools/dsh-session-context-config",
  "version": "1.2.0",
  "license": "MIT",
  "author": "Jia",
  "description": "Context profiles for new sessions: choose the tools and the system prompt each new conversation receives.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majia007/dsh-session-context-config.git"
  },
  "bugs": {
    "url": "https://github.com/majia007/dsh-session-context-config/issues"
  },
  "homepage": "https://github.com/majia007/dsh-session-context-config#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "context",
    "session",
    "system-prompt"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node build/build.mjs",
    "prepack": "node build/build.mjs",
    "prepare": "node build/build.mjs",
    "typecheck": "tsc --noEmit",
    "gen-known-tools": "node scripts/gen-known-tools.mjs",
    "test": "node --test --test-force-exit \"tests/**/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "happy-dom": "^20.11.6",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "~0.22.2",
    "typescript": "^6.0.3"
  }
}
